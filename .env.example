VITE_API_BASE_URL=http://localhost:8000

# Optional — sends X-Shop-Domain on every request, matching the backend's
# ALLOW_DEV_AUTH dev auth. Without it every list is empty (no merchant resolved).
VITE_DEV_SHOP_DOMAIN=

# Phase 1 OMS screens (orders/pending/inventory/mappings/channels/locations/
# activity/reports/allocation, plus auth+users) run on in-memory mock data —
# there's no Django backend for them yet. Defaults to true if unset. Set to
# "false" once those endpoints exist on the backend.
VITE_USE_MOCK=true
